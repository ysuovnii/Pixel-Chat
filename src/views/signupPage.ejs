<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up — Pixel Chat</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="theme-anti-gravity page--auth">
    <!-- <%- include('layout', { user: typeof user !== 'undefined' ? user : null, activePage: 'home' }) %> -->

    <main class="page-shell">
        <section class="auth-scroll float-3">
            <header class="auth-scroll__header">
                <h1 class="auth-scroll__title">PIXEL CHAT — SIGN UP</h1>
                <p class="auth-scroll__subtitle">
                    Engrave a new hero into the star registry.
                </p>
            </header>

            <% if (message) { %>
            <div class="error-box">
                <%= message %>
            </div>
            <% } %>

            <form action="/signup" method="POST">
                <div class="auth-form__group">
                    <label class="auth-form__label">USERNAME</label>
                    <input class="input-field" type="text" name="username" autocomplete="username"
                        placeholder="Sky_Princess_92" required />
                </div>

                <div class="auth-form__group">
                    <label class="auth-form__label">EMAIL</label>
                    <input class="input-field" type="email" name="email" autocomplete="email"
                        placeholder="hero@worlds.net" required />
                </div>

                <div class="auth-form__group">
                    <label class="auth-form__label">PASSWORD</label>
                    <input class="input-field" type="password" name="password" autocomplete="new-password"
                        placeholder="Min 6 characters" required />
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 8px;">
                    <span class="pixel-icon">▶</span>
                    <span>CREATE HERO SLOT</span>
                </button>
            </form>

            <div class="auth-scroll__footer">
                Already registered? <a href="/login">Return to login</a>
            </div>
        </section>
    </main>
</body>

</html>