<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile — Pixel Chat</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="theme-anti-gravity page--profile">
    <%- include('layout', { user: user, activePage: 'profile' }) %>

    <main class="page-shell">
        <section class="sheet float-2">
            <header class="sheet__header">
                <div>
                    <h1 class="sheet__title">CHARACTER SHEET</h1>
                    <p class="sheet__subtitle">
                        Tune your avatar and review stats.
                    </p>
                </div>
                <div class="sheet__subtitle">
                    ID:
                    <span style="color: var(--color-accent-cyan);">
                        <%= user.username %>
                    </span>
                </div>
            </header>

            <section class="sheet__body">
                <!-- Avatar & primary info -->
                <article class="sheet-avatar">
                    <div class="sheet-avatar__frame" onclick="document.getElementById('fileInput').click()">
                        <img id="avatarPreview"
                            src="<%= user.profilePic || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.username) + '&background=5A7A9A&color=fff&size=96&bold=true' %>"
                            alt="" />
                    </div>

                    <input type="file" id="fileInput" accept="image/*" style="display: none;" />

                    <div class="sheet-field" style="margin-top: 10px;">
                        <div class="sheet-field__label">USERNAME</div>
                        <div class="sheet-field__value">
                            <%= user.username %>
                        </div>
                    </div>

                    <div class="sheet-field">
                        <div class="sheet-field__label">EMAIL</div>
                        <div class="sheet-field__value">
                            <%= user.email %>
                        </div>
                    </div>
                </article>

                <!-- Stats & meta -->
                <article class="sheet-stats">
                    <div class="stat-row">
                        <div class="stat-row__label">HP — PROFILE COMPLETION</div>
                        <div class="stat-row__bar">
                            <div class="stat-row__bar-fill--hp" style="width: 80%;"></div>
                        </div>
                    </div>

                    <div class="stat-row">
                        <div class="stat-row__label">MP — CUSTOMIZATION DEPTH</div>
                        <div class="stat-row__bar">
                            <div class="stat-row__bar-fill--mp" style="width: 60%;"></div>
                        </div>
                    </div>

                    <div class="stat-row">
                        <div class="stat-row__label">XP — SESSION HISTORY</div>
                        <div class="stat-row__bar">
                            <div class="stat-row__bar-fill--xp" style="width: 40%;"></div>
                        </div>
                    </div>

                    <div class="sheet-actions">
                        <button id="uploadBtn" class="btn btn-primary" type="button" onclick="uploadProfilePic()"
                            disabled>
                            <span class="pixel-icon">⬆</span>
                            <span>UPLOAD AVATAR</span>
                        </button>

                        <a href="/home" class="btn btn-ghost">
                            <span class="pixel-icon">◂</span>
                            <span>BACK TO LOBBY</span>
                        </a>
                    </div>

                    <div id="statusLine" class="status-line"></div>
                </article>
            </section>
        </section>
    </main>

    <!-- ======================== AVATAR PREVIEW MODAL ======================== -->
    <div id="avatarModalOverlay" class="avatar-modal-overlay">
        <div class="avatar-modal float-2">
            <div class="avatar-modal__title">⚔ EQUIP NEW AVATAR? ⚔</div>
            <div class="avatar-modal__preview">
                <img id="modalPreview" src="" alt="Preview" />
            </div>
            <div class="avatar-modal__actions">
                <button id="modalConfirm" class="btn-confirm" type="button">
                    <span class="pixel-icon">✔</span>
                    <span>CONFIRM</span>
                </button>
                <button id="modalCancel" class="btn-cancel" type="button">
                    <span class="pixel-icon">✖</span>
                    <span>CANCEL</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        const fileInput = document.getElementById('fileInput');
        const preview = document.getElementById('avatarPreview');
        const uploadBtn = document.getElementById('uploadBtn');
        const statusLine = document.getElementById('statusLine');

        const modalOverlay = document.getElementById('avatarModalOverlay');
        const modalPreview = document.getElementById('modalPreview');
        const modalConfirm = document.getElementById('modalConfirm');
        const modalCancel = document.getElementById('modalCancel');

        let selectedBase64 = null;
        let pendingBase64 = null;

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) {
                setStatus('Max file size is 5MB.', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = () => {
                pendingBase64 = reader.result;
                modalPreview.src = pendingBase64;
                modalOverlay.classList.add('avatar-modal-overlay--open');
            };
            reader.readAsDataURL(file);
        });

        modalConfirm.addEventListener('click', () => {
            selectedBase64 = pendingBase64;
            preview.src = selectedBase64;
            uploadBtn.disabled = false;
            modalOverlay.classList.remove('avatar-modal-overlay--open');
            setStatus('Ready to upload new portrait.', 'success');
            pendingBase64 = null;
            fileInput.value = '';
        });

        modalCancel.addEventListener('click', () => {
            pendingBase64 = null;
            modalOverlay.classList.remove('avatar-modal-overlay--open');
            setStatus('Avatar change discarded.', 'error');
            fileInput.value = '';
        });

        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) {
                modalCancel.click();
            }
        });

        async function uploadProfilePic() {
            if (!selectedBase64) return;
            uploadBtn.disabled = true;
            uploadBtn.textContent = 'UPLOADING...';
            setStatus('Uploading to cloud...', 'success');
            try {
                const res = await fetch('/profile/update', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ profilePic: selectedBase64 })
                });
                const data = await res.json();
                if (res.ok) {
                    setStatus('Avatar updated successfully.', 'success');
                    selectedBase64 = null;
                } else {
                    setStatus(data.message || 'Upload failed.', 'error');
                    uploadBtn.disabled = false;
                }
            } catch (err) {
                setStatus('Something went wrong while uploading.', 'error');
                uploadBtn.disabled = false;
            }
            uploadBtn.textContent = 'UPLOAD AVATAR';
        }

        function setStatus(msg, type) {
            statusLine.textContent = msg;
            statusLine.className = 'status-line ' + (type === 'success'
                ? 'status-line--success'
                : type === 'error'
                    ? 'status-line--error'
                    : '');
        }
    </script>
</body>

</html>