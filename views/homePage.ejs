<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pixel Chat — Star Lobby</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body class="theme-anti-gravity page--home">
    <%- include('layout', { user: user, activePage: 'home' }) %>

    <!-- LOGOUT BUTTON — TOP RIGHT -->
    <a href="/logout" class="btn-escape float-2" style="position: fixed; top: 24px; right: 24px; z-index: 20;">
      <span class="pixel-icon">✖</span>
      <span>ESCAPE</span>
    </a>

    <main class="page-shell">
      <section class="home-layout">
        <!-- USER PROFILE CARD -->
        <section class="home-profile float-3">
          <div class="home-profile__stars float-4"></div>
          <div class="home-profile__content">
            <div class="home-profile__avatar-frame float-1">
              <img
                src="<%= user.profilePic || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.username) + '&background=5A7A9A&color=fff&size=96&bold=true' %>"
                alt="<%= user.username %>"
                class="home-profile__avatar"
              />
              <span class="home-profile__status-dot"></span>
            </div>

            <div class="home-profile__info">
              <div class="home-profile__label">HERO NAME</div>
              <div class="home-profile__username"><%= user.username %></div>

              <div class="home-profile__label" style="margin-top: 10px;">COMMS ID</div>
              <div class="home-profile__email"><%= user.email %></div>

              <div class="home-profile__label" style="margin-top: 10px;">STATUS</div>
              <div class="home-profile__status-text">● ONLINE</div>
            </div>

            <div class="home-profile__actions">
              <a href="/profile" class="btn btn-primary">
                <span class="pixel-icon">⚙</span>
                <span>EDIT PROFILE</span>
              </a>
            </div>
          </div>
        </section>

        <!-- PARTY LIST -->
        <aside class="home-party float-1">
          <header class="home-party__header">
            <h2 class="home-party__title">ONLINE PARTY</h2>
            <div class="home-party__count">
              <span id="partyCount">0</span> ONLINE
            </div>
          </header>
          <div id="partyGrid" class="home-party__grid">
            <div id="partyEmpty" class="home-party__empty">
              👾 No other players detected...<br />
              Waiting for a new challenger to appear.
            </div>
          </div>
        </aside>
      </section>
    </main>

    <script id="friendsData" type="application/json"><%- JSON.stringify(friendsList || []) %></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();
      const currentUser = "<%= user.username %>";
      const currentPic = "<%= user.profilePic || '' %>";
      const friendsList = JSON.parse(document.getElementById("friendsData").textContent);

      const makeAvatar = (name) =>
        `https://ui-avatars.com/api/?name=${encodeURIComponent(
          name
        )}&background=5A7A9A&color=fff&size=64&bold=true`;

      socket.on("connect", () => {
        socket.emit("userJoin", {
          username: currentUser,
          profilePic: currentPic,
        });
      });

      socket.on("onlineUsers", (users) => {
        const grid = document.getElementById("partyGrid");
        const empty = document.getElementById("partyEmpty");
        const count = document.getElementById("partyCount");

        // Only show users who are both online AND in the friends list
        const onlineFriends = users.filter(
          (u) => u.username !== currentUser && friendsList.includes(u.username)
        );
        count.textContent = onlineFriends.length;

        if (onlineFriends.length === 0) {
          if (empty) empty.style.display = "block";
          grid.innerHTML = "";
          empty.innerHTML = `👾 No friends online...<br/>
            <a href="/search" style="color: var(--color-accent-cyan); font-size: 8px;">
              🔍 Search for new allies
            </a>`;
          grid.appendChild(empty);
          return;
        }

        grid.innerHTML = "";

        onlineFriends.forEach((u, i) => {
          const card = document.createElement("a");
          card.href = `/chat/${encodeURIComponent(u.username)}`;
          card.className = "home-party-card float-2";
          card.style.animationDelay = `${(i * 0.3).toFixed(1)}s`;
          card.innerHTML = `
            <div class="home-party-card__avatar-wrap">
              <img class="home-party-card__avatar"
                src="${u.profilePic || makeAvatar(u.username)}"
                alt="" />
              <span class="home-party-card__status"></span>
            </div>
            <div class="home-party-card__info">
              <div class="home-party-card__name">${u.username}</div>
              <div class="home-party-card__action">▸ OPEN PRIVATE LINK</div>
            </div>
          `;
          grid.appendChild(card);
        });
      });
    </script>
  </body>
</html>