<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chat — <%= chatPartner %> | Pixel Chat</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body class="theme-anti-gravity page--chat">
    <%- include('layout', { user: user, activePage: 'chat' }) %>

    <main class="page-shell">
      <section class="chat-dialog float-2">
        <!-- Floating avatars overlapping dialogue box -->
        <div class="chat-dialog__avatars">
          <div class="chat-avatar chat-avatar--partner float-1">
            <img
              src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(chatPartner) %>&background=5A7A9A&color=fff&size=64&bold=true"
              alt=""
              id="partnerAvatar"
            />
          </div>
        </div>

        <header class="chat-dialog__header" style="padding: 14px 16px 10px;">
          <div>
            <div class="chat-dialog__name">
              <%= chatPartner %>
            </div>
            <div
              id="chatStatus"
              class="chat-dialog__status chat-dialog__status--offline"
            >
              Scanning for signal...
            </div>
          </div>
          <button class="btn btn-danger" type="button" onclick="showClearModal()" style="font-size:7px; padding:6px 10px;">
            <span class="pixel-icon">🗑</span>
            <span>CLEAR CHAT</span>
          </button>
        </header>

        <!-- Clear Chat Confirmation Modal -->
        <div id="clearChatOverlay" class="avatar-modal-overlay">
          <div class="avatar-modal float-2">
            <div class="avatar-modal__title">⚠ PURGE ALL MESSAGES? ⚠</div>
            <div style="font-size:8px; color:var(--color-text-muted); text-align:center; padding:16px 12px; line-height:1.8;">
              This action cannot be undone.<br/>
              All messages in this chat will be permanently destroyed.
            </div>
            <div class="avatar-modal__actions">
              <button id="clearConfirmBtn" class="btn-confirm" type="button" onclick="clearChat()">
                <span class="pixel-icon">✔</span>
                <span>CONFIRM</span>
              </button>
              <button class="btn-cancel" type="button" onclick="hideClearModal()">
                <span class="pixel-icon">✖</span>
                <span>CANCEL</span>
              </button>
            </div>
          </div>
        </div>

        <section id="chatLog" class="chat-log"></section>

        <footer class="chat-input">
          <!-- Typing indicator -->
          <div id="typingIndicator" class="typing-indicator typing-indicator--hidden">
            <span id="typingText"></span>
            <span class="typing-indicator__dots">
              <span class="typing-indicator__dot"></span>
              <span class="typing-indicator__dot"></span>
              <span class="typing-indicator__dot"></span>
            </span>
          </div>

          <!-- Single-row input bar -->
          <div class="chat-input__row">
            <div
              id="emojiToggle"
              class="chat-input__emoji"
              title="Emotes"
            >
              🙂
            </div>

            <div class="chat-input__shell">
              <span class="chat-input__prompt">»</span>
              <input
                id="messageInput"
                class="chat-input__field"
                type="text"
                placeholder="Type your spell..."
                autocomplete="off"
                onkeydown="if (event.key === 'Enter') sendMessage();"
              />
            </div>

            <button class="btn btn-primary" type="button" onclick="sendMessage()">
              <span class="pixel-icon">▶</span>
              <span>CAST</span>
            </button>
          </div>

          <div id="emojiPanel" class="emoji-panel">
            <div class="emoji-panel__section-label">SMILEYS</div>
            <div id="emojiGrid-smileys" class="emoji-panel__grid"></div>
            <div class="emoji-panel__section-label">GESTURES</div>
            <div id="emojiGrid-gestures" class="emoji-panel__grid"></div>
            <div class="emoji-panel__section-label">HEARTS</div>
            <div id="emojiGrid-hearts" class="emoji-panel__grid"></div>
            <div class="emoji-panel__section-label">OBJECTS</div>
            <div id="emojiGrid-objects" class="emoji-panel__grid"></div>
            <div class="emoji-panel__section-label">ANIMALS</div>
            <div id="emojiGrid-animals" class="emoji-panel__grid"></div>
          </div>
        </footer>
      </section>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();
      const currentUser = "<%= user.username %>";
      const currentPic = "<%= user.profilePic || '' %>";
      const chatPartner = "<%= chatPartner %>";

      const partnerStatusEl = document.getElementById("chatStatus");
      const chatLog = document.getElementById("chatLog");
      const msgInput = document.getElementById("messageInput");
      const partnerAvatarEl = document.getElementById("partnerAvatar");
      const typingIndicator = document.getElementById("typingIndicator");
      const typingText = document.getElementById("typingText");

      // State (kept for snippet / future use if needed)
      const conversations = new Map();

      socket.on("connect", () => {
        socket.emit("userJoin", {
          username: currentUser,
          profilePic: currentPic,
        });
      });

      socket.on("onlineUsers", (users) => {
        const partnerOnline = users.find((u) => u.username === chatPartner);
        if (partnerOnline) {
          partnerStatusEl.textContent = "● Online";
          partnerStatusEl.className =
            "chat-dialog__status chat-dialog__status--online";
          if (partnerOnline.profilePic) {
            partnerAvatarEl.src = partnerOnline.profilePic;
          }
        } else {
          partnerStatusEl.textContent = "○ OFFLINE";
          partnerStatusEl.className =
            "chat-dialog__status chat-dialog__status--offline";
        }
      });

      // ===== TYPING INDICATOR =====
      let typingTimeout = null;
      let isTyping = false;

      msgInput.addEventListener("input", () => {
        if (!isTyping) {
          isTyping = true;
          socket.emit("typing", { from: currentUser, to: chatPartner });
        }
        clearTimeout(typingTimeout);
        typingTimeout = setTimeout(() => {
          isTyping = false;
          socket.emit("stopTyping", { from: currentUser, to: chatPartner });
        }, 1500);
      });

      socket.on("userTyping", ({ from }) => {
        if (from === chatPartner) {
          typingText.textContent = `${from} is casting a spell`;
          typingIndicator.classList.remove("typing-indicator--hidden");
        }
      });

      socket.on("userStopTyping", ({ from }) => {
        if (from === chatPartner) {
          typingIndicator.classList.add("typing-indicator--hidden");
        }
      });

      function timeStr() {
        const d = new Date();
        let h = d.getHours(),
          m = d.getMinutes();
        const ap = h >= 12 ? "PM" : "AM";
        h = h % 12 || 12;
        return `${h}:${String(m).padStart(2, "0")} ${ap}`;
      }

      function appendMessageBubble({ from, message, time }) {
        const isSelf = from === currentUser;
        const row = document.createElement("div");
        row.className = "msg-row " + (isSelf ? "msg-row--self" : "msg-row--other");

        const bubble = document.createElement("div");
        bubble.className =
          "msg-bubble " + (isSelf ? "msg-bubble--self" : "msg-bubble--other");

        const textDiv = document.createElement("div");
        textDiv.className = "msg-text";
        textDiv.innerHTML = pixelateEmojisInText(message);

        const meta = document.createElement("div");
        meta.className = "msg-meta";
        meta.textContent = time;

        bubble.appendChild(textDiv);
        bubble.appendChild(meta);
        row.appendChild(bubble);
        chatLog.appendChild(row);
        chatLog.scrollTop = chatLog.scrollHeight;
      }

      function sendMessage() {
        const text = msgInput.value.trim();
        if (!text) return;

        // Stop typing when sending
        if (isTyping) {
          isTyping = false;
          clearTimeout(typingTimeout);
          socket.emit("stopTyping", { from: currentUser, to: chatPartner });
        }

        socket.emit("sendMessage", {
          from: currentUser,
          to: chatPartner,
          message: text,
          profilePic: currentPic,
        });

        msgInput.value = "";
      }

      socket.on("receiveMessage", ({ from, to, message }) => {
        const time = timeStr();
        const partner = from === currentUser ? to : from;
        const msgObj = { from, message, time };

        if (!conversations.has(partner)) {
          conversations.set(partner, []);
        }
        conversations.get(partner).push(msgObj);

        if (partner === chatPartner) {
          appendMessageBubble(msgObj);
        }
      });

      // ===== PIXEL EMOJI ENGINE =====
      const emojiCanvasCache = new Map();
      function pixelateEmoji(emoji, size = 18) {
        if (emojiCanvasCache.has(emoji)) return emojiCanvasCache.get(emoji);
        const canvas = document.createElement("canvas");
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext("2d");
        ctx.clearRect(0, 0, size, size);
        ctx.font = `${size - 2}px serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(emoji, size / 2, size / 2 + 1);
        const url = canvas.toDataURL();
        emojiCanvasCache.set(emoji, url);
        return url;
      }

      const emojiRegex = /(\p{Emoji_Presentation}|\p{Emoji}\uFE0F)/gu;
      function pixelateEmojisInText(text) {
        return text.replace(emojiRegex, (match) => {
          const src = pixelateEmoji(match);
          return `<img src="${src}" class="pixel-emoji" alt="${match}" title="${match}">`;
        });
      }

      const emojiData = {
        smileys: [
          "😀", "😁", "😂", "🤣", "😃", "😄", "😆", "😉", "😊", "😎", "🤩", "😍",
        ],
        gestures: ["👋", "👌", "✌️", "🤞", "🤟", "👍", "👎", "👏", "🙏"],
        hearts: ["❤️", "🧡", "💛", "💚", "💙", "💜", "🖤", "🤍", "🤎"],
        objects: ["⚔️", "🛡️", "🎮", "🕹️", "🎲", "🏆", "🔥", "⚡", "💥", "💫"],
        animals: ["🐱", "🐶", "🦊", "🐻", "🐼", "🐸", "🐵", "🐧", "🐉"],
      };

      Object.entries(emojiData).forEach(([cat, list]) => {
        const grid = document.getElementById("emojiGrid-" + cat);
        if (!grid) return;
        list.forEach((e) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "emoji-panel__btn";
          const img = document.createElement("img");
          img.src = pixelateEmoji(e);
          img.className = "pixel-emoji";
          img.alt = e;
          btn.appendChild(img);
          btn.onclick = () => insertEmoji(e);
          grid.appendChild(btn);
        });
      });

      (function () {
        const toggle = document.getElementById("emojiToggle");
        const img = document.createElement("img");
        img.src = pixelateEmoji("😀");
        img.className = "pixel-emoji";
        img.alt = "😀";
        toggle.textContent = "";
        toggle.appendChild(img);
      })();

      const emojiPanel = document.getElementById("emojiPanel");
      document
        .getElementById("emojiToggle")
        .addEventListener("click", function () {
          emojiPanel.classList.toggle("emoji-panel--open");
        });

      function insertEmoji(emoji) {
        const start = msgInput.selectionStart;
        const end = msgInput.selectionEnd;
        msgInput.value =
          msgInput.value.substring(0, start) +
          emoji +
          msgInput.value.substring(end);
        msgInput.focus();
        msgInput.selectionStart = msgInput.selectionEnd = start + emoji.length;
      }

      document.addEventListener("click", (e) => {
        if (
          !emojiPanel.contains(e.target) &&
          !document.getElementById("emojiToggle").contains(e.target)
        ) {
          emojiPanel.classList.remove("emoji-panel--open");
        }
      });

      async function loadMessages() {
        try {
          const res = await fetch(`/message/${chatPartner}`);
          const messages = await res.json();

          console.log("Loaded messages:", messages);

          if (!Array.isArray(messages)) return;

          chatLog.innerHTML = ""; // clear old messages

          messages.forEach((msg) => {
            appendMessageBubble({
              from: msg.senderID,
              message: msg.text,
              time: new Date(msg.createdAt).toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit",
              }),
            });
          });

          chatLog.scrollTop = chatLog.scrollHeight;

        } catch (err) {
          console.error("Failed to load messages", err);
        }
      }

      // ===== CLEAR CHAT =====
      function showClearModal() {
        document.getElementById('clearChatOverlay').classList.add('avatar-modal-overlay--open');
      }
      function hideClearModal() {
        document.getElementById('clearChatOverlay').classList.remove('avatar-modal-overlay--open');
      }

      async function clearChat() {
        try {
          const res = await fetch(`/message/${chatPartner}`, { method: 'DELETE' });
          if (res.ok) {
            chatLog.innerHTML = '';
            conversations.clear();
            hideClearModal();
          } else {
            console.error('Failed to clear chat');
          }
        } catch (err) {
          console.error('Error clearing chat:', err);
        }
      }

      // focus input on load
      msgInput.focus();
      loadMessages();
    </script>
  </body>
</html>