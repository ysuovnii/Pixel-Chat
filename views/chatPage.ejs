<%= '' /* chatPage.ejs – Pixel Art Private Chat */ %>
  <!DOCTYPE html>
  <html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat — <%= chatPartner %> | Pixel Chat</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
      /* ═══════════════════════════════════════════
           RESET & BASE
           ═══════════════════════════════════════════ */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Press Start 2P', monospace;
        background: #1a1a2e;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        image-rendering: pixelated;
        image-rendering: crisp-edges;
      }

      /* Scanline */
      body::after {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        background: repeating-linear-gradient(0deg, transparent, transparent 2px,
            rgba(0, 0, 0, 0.06) 2px, rgba(0, 0, 0, 0.06) 4px);
        z-index: 999;
      }

      /* ═══════════════════════════════════════════
           OUTER FRAME
           ═══════════════════════════════════════════ */
      .app-frame {
        width: 96vw;
        max-width: 1100px;
        height: 94vh;
        max-height: 720px;
        background: #16213e;
        border: 4px solid #0f3460;
        box-shadow:
          inset 2px 2px 0 #1e3a5f,
          inset -2px -2px 0 #0a1a30,
          6px 6px 0 rgba(0, 0, 0, 0.4);
        display: flex;
        overflow: hidden;
      }

      /* ═══════════════════════════════════════════
           LEFT SIDEBAR
           ═══════════════════════════════════════════ */
      .sidebar {
        width: 240px;
        min-width: 240px;
        background: #0f1a2e;
        border-right: 3px solid #0f3460;
        display: flex;
        flex-direction: column;
      }

      .sidebar-header {
        background: #0a1420;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 3px solid #0f3460;
      }

      .sidebar-header .chat-icon {
        font-size: 14px;
      }

      .sidebar-header h1 {
        font-size: 10px;
        color: #53d769;
        text-shadow: 1px 1px 0 #1a4a1a;
        letter-spacing: 2px;
      }

      /* ── Contact List ── */
      .contact-list {
        flex: 1;
        overflow-y: auto;
      }

      .contact-list::-webkit-scrollbar {
        width: 6px;
      }

      .contact-list::-webkit-scrollbar-track {
        background: #0a1420;
      }

      .contact-list::-webkit-scrollbar-thumb {
        background: #1e3a5f;
      }

      .contact-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-bottom: 1px solid #162040;
        cursor: pointer;
        transition: background 0.1s;
        text-decoration: none;
        color: inherit;
      }

      .contact-item:hover {
        background: #162850;
      }

      .contact-item.active {
        background: #0f3460;
        border-left: 3px solid #53d769;
      }

      .contact-item.active .contact-name {
        color: #53d769;
      }

      .contact-avatar-wrap {
        position: relative;
        flex-shrink: 0;
      }

      .contact-avatar {
        width: 36px;
        height: 36px;
        border: 2px solid #0f3460;
        background: #5A7A9A;
        image-rendering: pixelated;
        object-fit: cover;
      }

      .contact-item.active .contact-avatar {
        border-color: #53d769;
      }

      .status-dot {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 8px;
        height: 8px;
        border: 2px solid #0f1a2e;
      }

      .status-dot.online {
        background: #53d769;
      }

      .contact-info {
        flex: 1;
        min-width: 0;
      }

      .contact-name {
        font-size: 8px;
        color: #8AB8D8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .contact-snippet {
        font-size: 7px;
        color: #3a5a7a;
        margin-top: 2px;
      }

      /* ── Sidebar Footer ── */
      .sidebar-section-title {
        font-size: 7px;
        color: #3a5a7a;
        padding: 8px 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-top: 1px solid #162040;
        background: #0a1420;
      }

      .sidebar-footer {
        border-top: 2px solid #0f3460;
        background: #0a1420;
        padding: 6px;
        display: flex;
        gap: 4px;
      }

      .sidebar-footer a {
        text-decoration: none;
        flex: 1;
      }

      .sidebar-footer-btn {
        width: 100%;
        font-family: 'Press Start 2P', monospace;
        font-size: 7px;
        color: #8AB8D8;
        padding: 7px 4px;
        background: #162040;
        border: 2px solid #0f3460;
        cursor: pointer;
        text-align: center;
        transition: background 0.1s;
      }

      .sidebar-footer-btn:hover {
        background: #1e3a5f;
      }

      .sidebar-footer-btn.danger {
        color: #CC7A7A;
        border-color: #5A2A2A;
      }

      .sidebar-footer-btn.danger:hover {
        background: #3A1A1A;
      }

      /* ═══════════════════════════════════════════
           RIGHT CHAT WINDOW
           ═══════════════════════════════════════════ */
      .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #131b2e;
      }

      /* ── Chat Header ── */
      .chat-header {
        padding: 10px 16px;
        background: #16213e;
        border-bottom: 3px solid #0f3460;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .chat-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .chat-header-avatar {
        width: 32px;
        height: 32px;
        border: 2px solid #0f3460;
        image-rendering: pixelated;
        object-fit: cover;
      }

      .chat-header-name {
        font-size: 10px;
        color: #E0E8F0;
      }

      .chat-header-status {
        font-size: 7px;
        color: #53d769;
        margin-top: 2px;
      }

      .chat-header-status.offline {
        color: #5a7a9a;
      }

      /* ═══════════════════════════════════════════
           MESSAGES
           ═══════════════════════════════════════════ */
      .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 14px 18px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .chat-messages::-webkit-scrollbar {
        width: 6px;
      }

      .chat-messages::-webkit-scrollbar-track {
        background: #131b2e;
      }

      .chat-messages::-webkit-scrollbar-thumb {
        background: #1e3a5f;
      }

      .msg-row {
        display: flex;
        max-width: 72%;
        animation: msgSlide 0.2s ease;
      }

      @keyframes msgSlide {
        from {
          opacity: 0;
          transform: translateY(6px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .msg-row.incoming {
        align-self: flex-start;
      }

      .msg-row.outgoing {
        align-self: flex-end;
      }

      .msg-bubble {
        padding: 10px 14px 6px;
        position: relative;
        border: 2px solid #0f3460;
        box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.2);
      }

      .msg-row.incoming .msg-bubble {
        background: #1a3a2a;
        border-color: #2a5a3a;
        border-radius: 0 6px 6px 0;
        margin-left: 6px;
      }

      .msg-row.incoming .msg-bubble::before {
        content: '';
        position: absolute;
        left: -8px;
        bottom: 6px;
        width: 8px;
        height: 12px;
        background: #1a3a2a;
        border-left: 2px solid #2a5a3a;
        border-bottom: 2px solid #2a5a3a;
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
      }

      .msg-row.outgoing .msg-bubble {
        background: #1a2a4a;
        border-color: #2a4a6a;
        border-radius: 6px 0 0 6px;
        margin-right: 6px;
      }

      .msg-row.outgoing .msg-bubble::after {
        content: '';
        position: absolute;
        right: -8px;
        bottom: 6px;
        width: 8px;
        height: 12px;
        background: #1a2a4a;
        border-right: 2px solid #2a4a6a;
        border-bottom: 2px solid #2a4a6a;
        clip-path: polygon(0 0, 100% 100%, 0 100%);
      }

      .msg-text {
        font-size: 9px;
        color: #C0D0E0;
        line-height: 1.7;
        word-break: break-word;
      }

      .msg-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        margin-top: 4px;
      }

      .msg-time {
        font-size: 7px;
        color: #3a5a7a;
      }

      .check {
        display: inline-flex;
        gap: 1px;
      }

      .check-single::after {
        content: '✓';
        font-size: 8px;
        color: #3a8a3a;
      }

      .check-double::after {
        content: '✓✓';
        font-size: 8px;
        color: #4a8aca;
        letter-spacing: -2px;
      }

      /* ═══════════════════════════════════════════
           INPUT BAR
           ═══════════════════════════════════════════ */
      .chat-input-bar {
        padding: 10px 14px;
        background: #16213e;
        border-top: 3px solid #0f3460;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .msg-input {
        flex: 1;
        padding: 8px 12px;
        font-family: 'Press Start 2P', monospace;
        font-size: 9px;
        color: #C0D0E0;
        background: #0a1420;
        border: 3px solid;
        border-color: #0f3460 #1e3a5f #1e3a5f #0f3460;
        outline: none;
      }

      .msg-input::placeholder {
        color: #2a4a6a;
      }

      .msg-input:focus {
        border-color: #53d769 #2a5a3a #2a5a3a #53d769;
        background: #0f1a2e;
      }

      .send-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        font-family: 'Press Start 2P', monospace;
        font-size: 9px;
        color: #0a1420;
        background: linear-gradient(180deg, #53d769 0%, #3A9A4A 100%);
        border: 3px solid;
        border-color: #7AE88A #1A6A2A #1A6A2A #7AE88A;
        cursor: pointer;
        text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.2);
        transition: filter 0.1s;
        white-space: nowrap;
      }

      .send-btn:hover {
        filter: brightness(1.1);
      }

      .send-btn:active {
        filter: brightness(0.9);
        border-color: #1A6A2A #7AE88A #7AE88A #1A6A2A;
      }

      /* ═══════════════════════════════════════════
           EMOJI PICKER
           ═══════════════════════════════════════════ */
      .emoji-picker-wrap {
        position: relative;
      }

      .emoji-toggle-btn {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #162040;
        border: 2px solid #0f3460;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.1s;
      }

      .emoji-toggle-btn:hover {
        background: #1e3a5f;
      }

      .emoji-panel {
        display: none;
        position: absolute;
        bottom: 40px;
        left: 0;
        width: 260px;
        max-height: 200px;
        background: #0f1a2e;
        border: 3px solid #0f3460;
        box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.3);
        overflow-y: auto;
        z-index: 100;
        padding: 6px;
      }

      .emoji-panel.open {
        display: block;
      }

      .emoji-panel::-webkit-scrollbar {
        width: 6px;
      }

      .emoji-panel::-webkit-scrollbar-thumb {
        background: #1e3a5f;
      }

      .emoji-category {
        font-size: 7px;
        color: #3a5a7a;
        padding: 4px 2px 2px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .emoji-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
      }

      .emoji-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 2px solid transparent;
        cursor: pointer;
        transition: background 0.1s;
        padding: 2px;
      }

      .emoji-btn:hover {
        background: #162850;
        border-color: #0f3460;
      }

      .emoji-btn img,
      .pixel-emoji {
        width: 24px;
        height: 24px;
        image-rendering: pixelated;
        image-rendering: crisp-edges;
      }

      .msg-text .pixel-emoji {
        width: 16px;
        height: 16px;
        vertical-align: middle;
        margin: 0 1px;
      }

      .emoji-toggle-btn .pixel-emoji {
        width: 18px;
        height: 18px;
      }

      /* ═══════════════════════════════════════════
           RESPONSIVE
           ═══════════════════════════════════════════ */
      @media (max-width: 800px) {
        .app-frame {
          width: 100vw;
          height: 100vh;
          max-width: none;
          max-height: none;
          border-width: 3px;
        }

        .sidebar {
          width: 180px;
          min-width: 180px;
        }
      }

      @media (max-width: 580px) {
        .sidebar {
          display: none;
        }
      }
    </style>
  </head>

  <body>

    <div class="app-frame">

      <!-- ═══════════════ LEFT SIDEBAR ═══════════════ -->
      <aside class="sidebar">

        <div class="sidebar-header">
          <span class="chat-icon">💬</span>
          <h1>PIXEL CHAT</h1>
        </div>

        <div class="contact-list" id="contactList">
          <!-- Online users injected here dynamically -->
        </div>

        <div class="sidebar-section-title">
          ONLINE: <span id="onlineCount">0</span> player(s)
        </div>

        <div class="sidebar-footer">
          <a href="/home"><button class="sidebar-footer-btn">◂ HOME</button></a>
          <a href="/profile"><button class="sidebar-footer-btn">⚙ PROFILE</button></a>
          <a href="/logout"><button class="sidebar-footer-btn danger">⏻ EXIT</button></a>
        </div>
      </aside>

      <!-- ═══════════════ RIGHT CHAT ═══════════════ -->
      <main class="chat-main">

        <div class="chat-header" id="chatHeader">
          <div class="chat-header-left">
            <img class="chat-header-avatar" id="chatHeaderAvatar"
              src="https://ui-avatars.com/api/?name=<%= chatPartner %>&background=5A7A9A&color=fff&size=32&bold=true"
              alt="" />
            <div>
              <div class="chat-header-name" id="chatHeaderName">
                <%= chatPartner %>
              </div>
              <div class="chat-header-status" id="chatHeaderStatus">Connecting...</div>
            </div>
          </div>
        </div>

        <div class="chat-messages" id="chatBox"></div>

        <div class="chat-input-bar">
          <div class="emoji-picker-wrap">
            <button class="emoji-toggle-btn" id="emojiToggle" onclick="toggleEmojiPicker()" title="Emoji">😀</button>
            <div class="emoji-panel" id="emojiPanel">
              <div class="emoji-category">Smileys</div>
              <div class="emoji-grid" id="emojiGrid-smileys"></div>
              <div class="emoji-category">Gestures</div>
              <div class="emoji-grid" id="emojiGrid-gestures"></div>
              <div class="emoji-category">Hearts</div>
              <div class="emoji-grid" id="emojiGrid-hearts"></div>
              <div class="emoji-category">Objects</div>
              <div class="emoji-grid" id="emojiGrid-objects"></div>
              <div class="emoji-category">Animals</div>
              <div class="emoji-grid" id="emojiGrid-animals"></div>
            </div>
          </div>
          <input class="msg-input" type="text" id="messageInput" placeholder="Type your message..." autocomplete="off"
            onkeydown="if(event.key==='Enter') sendMessage()" />
          <button class="send-btn" onclick="sendMessage()">SEND →</button>
        </div>
      </main>
    </div>

    <!-- ═══════════════ SOCKET LOGIC ═══════════════ -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();
      const currentUser = "<%= user.username %>";
      const currentPic = "<%= user.profilePic || '' %>";
      const chatPartner = "<%= chatPartner %>";
      const pixelAvatar = (name) =>
        `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=5A7A9A&color=fff&size=40&bold=true`;

      // State
      const conversations = new Map();

      // Announce self
      socket.on("connect", () => {
        socket.emit("userJoin", { username: currentUser, profilePic: currentPic });
      });

      // ── Online Users ──
      socket.on("onlineUsers", (users) => {
        const list = document.getElementById("contactList");
        const count = document.getElementById("onlineCount");
        const others = users.filter(u => u.username !== currentUser);
        count.textContent = others.length;

        // Update chat partner status
        const partnerOnline = users.find(u => u.username === chatPartner);
        const statusEl = document.getElementById("chatHeaderStatus");
        if (partnerOnline) {
          statusEl.textContent = "● ONLINE";
          statusEl.className = "chat-header-status";
          // Update avatar if partner has one
          if (partnerOnline.profilePic) {
            document.getElementById("chatHeaderAvatar").src = partnerOnline.profilePic;
          }
        } else {
          statusEl.textContent = "○ OFFLINE";
          statusEl.className = "chat-header-status offline";
        }

        // Build sidebar
        list.innerHTML = '';
        others.forEach(u => {
          const a = document.createElement('a');
          a.href = `/chat/${encodeURIComponent(u.username)}`;
          a.className = 'contact-item' + (u.username === chatPartner ? ' active' : '');
          a.innerHTML = `
                    <div class="contact-avatar-wrap">
                        <img class="contact-avatar" src="${u.profilePic || pixelAvatar(u.username)}" alt="" />
                        <span class="status-dot online"></span>
                    </div>
                    <div class="contact-info">
                        <span class="contact-name">${u.username}</span>
                        <span class="contact-snippet">${getLastSnippet(u.username)}</span>
                    </div>`;
          list.appendChild(a);
        });
      });

      function getLastSnippet(username) {
        const msgs = conversations.get(username);
        if (!msgs || msgs.length === 0) return 'Online';
        const last = msgs[msgs.length - 1];
        const prefix = last.from === currentUser ? 'You: ' : '';
        const text = prefix + last.message;
        return text.length > 20 ? text.substring(0, 20) + '...' : text;
      }

      // ── Append message bubble ──
      function appendMessageBubble({ from, message, time }) {
        const box = document.getElementById('chatBox');
        const isSelf = from === currentUser;
        const dir = isSelf ? 'outgoing' : 'incoming';

        const div = document.createElement('div');
        div.className = `msg-row ${dir}`;
        div.innerHTML = `
                <div class="msg-bubble">
                    <div class="msg-text">${pixelateEmojisInText(message)}</div>
                    <div class="msg-footer">
                        <span class="msg-time">${time}</span>
                        <span class="check ${isSelf ? 'check-double' : 'check-single'}"></span>
                    </div>
                </div>`;
        box.appendChild(div);
      }

      // ── Send Message ──
      function sendMessage() {
        const input = document.getElementById('messageInput');
        const message = input.value.trim();
        if (!message) return;
        socket.emit('sendMessage', {
          from: currentUser,
          to: chatPartner,
          message,
          profilePic: currentPic
        });
        input.value = '';
      }

      // ── Time Helper ──
      function timeStr() {
        const d = new Date();
        let h = d.getHours(), m = d.getMinutes();
        const ap = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        return `${h}:${String(m).padStart(2, '0')} ${ap}`;
      }

      // ── Receive Message ──
      socket.on('receiveMessage', ({ from, to, message, profilePic }) => {
        const time = timeStr();
        const msgObj = { from, message, time };
        const partner = from === currentUser ? to : from;

        if (!conversations.has(partner)) conversations.set(partner, []);
        conversations.get(partner).push(msgObj);

        // Only display if it belongs to current chat
        if (partner === chatPartner) {
          appendMessageBubble(msgObj);
          const box = document.getElementById('chatBox');
          box.scrollTop = box.scrollHeight;
        }

        // Update sidebar snippet
        const contactEl = document.querySelector(`.contact-item[href="/chat/${encodeURIComponent(partner)}"]`);
        if (contactEl) {
          const snippet = contactEl.querySelector('.contact-snippet');
          if (snippet) snippet.textContent = getLastSnippet(partner);
        }
      });

      // ═══════════════ PIXELATED EMOJI ENGINE ═══════════════
      const emojiCanvasCache = new Map();

      function pixelateEmoji(emoji, size = 14) {
        if (emojiCanvasCache.has(emoji)) return emojiCanvasCache.get(emoji);
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, size, size);
        ctx.font = `${size - 2}px serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(emoji, size / 2, size / 2 + 1);
        const url = canvas.toDataURL();
        emojiCanvasCache.set(emoji, url);
        return url;
      }

      const emojiRegex = /(\p{Emoji_Presentation}|\p{Emoji}\uFE0F)/gu;
      function pixelateEmojisInText(text) {
        return text.replace(emojiRegex, (match) => {
          const src = pixelateEmoji(match);
          return `<img src="${src}" class="pixel-emoji" alt="${match}" title="${match}">`;
        });
      }

      // ── Emoji Picker ──
      const emojiData = {
        smileys: ['😀', '😁', '😂', '🤣', '😃', '😄', '😅', '😆', '😉', '😊', '😎', '🤩', '😍', '🥰', '😘', '😋', '😛', '😜', '🤪', '😝', '🤗', '🤔', '😐', '😑', '😶', '🙄', '😏', '😒', '😔', '😪', '😴', '🤮', '🤧', '🥴', '😵', '🤯', '🤠', '🥳', '😈'],
        gestures: ['👋', '🤚', '✋', '🖐', '👌', '🤌', '🤏', '✌️', '🤞', '🤟', '🤘', '🤙', '👈', '👉', '👆', '👇', '☝️', '👍', '👎', '✊', '👊', '🤛', '🤜', '👏', '🙌', '👐', '🤝', '🙏'],
        hearts: ['❤️', '🧡', '💛', '💚', '💙', '💜', '🖤', '🤍', '🤎', '💔', '❣️', '💕', '💞', '💓', '💗', '💖', '💘', '💝', '💟'],
        objects: ['⚔️', '🛡️', '🎮', '🕹️', '🎲', '🧩', '🏆', '🥇', '🎵', '🎶', '🔥', '⚡', '💥', '💫', '🌟', '⭐', '✨', '🎯', '🚀', '💣', '💎', '🔑', '🗝️', '🪙', '💰'],
        animals: ['🐱', '🐶', '🐺', '🦊', '🐻', '🐼', '🐸', '🐵', '🐧', '🐦', '🦅', '🦆', '🦉', '🐴', '🦄', '🐝', '🐛', '🦋', '🐌', '🐙', '🐠', '🐡', '🦈', '🐊', '🐉', '🐲']
      };

      // Build grids with pixelated images
      Object.entries(emojiData).forEach(([cat, emojis]) => {
        const grid = document.getElementById('emojiGrid-' + cat);
        if (!grid) return;
        emojis.forEach(e => {
          const btn = document.createElement('button');
          btn.className = 'emoji-btn';
          btn.type = 'button';
          const img = document.createElement('img');
          img.src = pixelateEmoji(e);
          img.className = 'pixel-emoji';
          img.alt = e;
          btn.appendChild(img);
          btn.onclick = () => insertEmoji(e);
          grid.appendChild(btn);
        });
      });

      // Pixelate toggle button
      (function () {
        const toggle = document.getElementById('emojiToggle');
        const img = document.createElement('img');
        img.src = pixelateEmoji('😀');
        img.className = 'pixel-emoji';
        img.alt = '😀';
        toggle.textContent = '';
        toggle.appendChild(img);
      })();

      function toggleEmojiPicker() {
        document.getElementById('emojiPanel').classList.toggle('open');
      }

      function insertEmoji(emoji) {
        const input = document.getElementById('messageInput');
        const start = input.selectionStart;
        const end = input.selectionEnd;
        input.value = input.value.substring(0, start) + emoji + input.value.substring(end);
        input.focus();
        input.selectionStart = input.selectionEnd = start + emoji.length;
      }

      document.addEventListener('click', (e) => {
        const panel = document.getElementById('emojiPanel');
        const toggle = document.getElementById('emojiToggle');
        if (!panel.contains(e.target) && !toggle.contains(e.target)) {
          panel.classList.remove('open');
        }
      });

      // Focus input on load
      document.getElementById('messageInput').focus();
    </script>

  </body>

  </html>